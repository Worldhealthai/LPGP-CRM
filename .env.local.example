# ============================================================================
# LPGP Connect CRM — environment variables
# Copy to .env.local for local dev, and add the same names in Vercel
# (Project → Settings → Environment Variables) for production.
# ============================================================================

# --- Supabase (Project → Settings → API) -----------------------------------
# Used by the browser + server to READ data. Safe to expose (anon, RLS-guarded).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only key used for WRITES (importing leads, editing profiles, notes).
# NEVER expose this to the browser or commit it. Server routes only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Lusha (https://dashboard.lusha.com → API) ------------------------------
# REST API key the in-app import tool uses to pull leads. Server-only.
LUSHA_API_KEY=your-lusha-api-key

# --- Optional: shared password gate (off by default) ------------------------
# Leave unset for an open app. Set a value to require this password to enter.
# APP_ACCESS_PASSWORD=
